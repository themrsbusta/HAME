{
  "backend": "cli",
  "llama_server": "",
  "llama_cli": "llama/llama-cli",
  "main_model": "models/main.gguf",
  "compiler_model": "models/compiler.gguf",
  "main_device": "none",
  "compiler_device": "none",
  "data_dir": "data",
  "listen": "127.0.0.1:8088",
  "mode": "constrained",
  "context_tokens": 8192,
  "output_tokens": 1024,
  "gpu_layers": "0",
  "compaction_threshold_percent": 90,
  "reserve_tokens": 1024,
  "template_reserve_tokens": 128,
  "compiled_memory_max_tokens": 1024,
  "memory_policy": "hybrid",
  "prefill_compiled_context": true,
  "main_extra_args": "",
  "main_mmproj": "",
  "llama_version": "declare sua versão do llama.cpp",
  "llama_capabilities": [
    "--model",
    "--ctx-size",
    "--gpu-layers",
    "--file",
    "--system-prompt-file",
    "--single-turn",
    "--simple-io",
    "--no-display-prompt",
    "--log-disable",
    "--no-show-timings",
    "--output-file",
    "--n-predict",
    "--no-escape"
  ],
  "webui": "embedded",
  "continuous_history": true,
  "retrieval_tokens": 512
}
