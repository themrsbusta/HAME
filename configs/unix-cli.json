{
  "generation": {
    "output_tokens": "fixed",
    "reserve_tokens": "fixed",
    "artificial_output_limit": true
  },
  "context": {
    "capacity": "configured",
    "kv_cache_monitoring": false,
    "compaction": {
      "enabled": false,
      "trigger": {
        "type": "configured_limit",
        "threshold_percent": 75
      },
      "strategy": []
    }
  },
  "completion": {
    "success_requires": ["natural_completion", "valid_tool_cycle_if_required"],
    "truncated_response": {
      "mark_completed": false,
      "attempt_recovery": true
    }
  },
  "safety": {
    "explicit_cancellation": true,
    "resource_exhaustion_handling": true,
    "detect_stalled_generation": false
  },
  "backend": "cli",
  "llama_server": "",
  "llama_cli": "llama/llama-cli",
  "main_model": "models/main.gguf",
  "compiler_model": "models/compiler.gguf",
  "main_device": "none",
  "compiler_device": "none",
  "data_dir": "data",
  "listen": "127.0.0.1:8088",
  "mode": "constrained",
  "context_tokens": 8192,
  "output_tokens": 1024,
  "gpu_layers": "0",
  "compaction_threshold_percent": 75,
  "reserve_tokens": 1024,
  "template_reserve_tokens": 128,
  "compiled_memory_max_tokens": 1024,
  "memory_policy": "hybrid",
  "prefill_compiled_context": true,
  "main_extra_args": "",
  "main_mmproj": "",
  "llama_version": "declare sua versão do llama.cpp",
  "llama_capabilities": [
    "--model",
    "--ctx-size",
    "--gpu-layers",
    "--file",
    "--system-prompt-file",
    "--single-turn",
    "--simple-io",
    "--no-display-prompt",
    "--log-disable",
    "--no-show-timings",
    "--output-file",
    "--n-predict",
    "--no-escape"
  ],
  "webui": "embedded",
  "continuous_history": true,
  "retrieval_tokens": 512
}
